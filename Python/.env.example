# Google Gemini API key for analysis notebooks
GOOGLE_API_KEY=your-gemini-api-key-here

# Google Cloud credentials (optional - can also use local JSON file)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# --- Outreach service (linkedinmcp) ------------------------------------------
# Read by the `linkedin-outreach` Cloud Run service, which loads this file and
# then `linkedinmcp/.env` on top of it. The notebooks ignore everything here.

# The single fixed token the service authenticates every request with. The
# Claude agent platform, Claude connectors, Cloud Scheduler and the Unipile
# webhook all present it, as either `x-api-key: <token>` or
# `Authorization: Bearer <token>`; no other header form is accepted.
#
# Minimum 16 characters, enforced at startup -- an empty key would authenticate
# every caller on a public URL, so the service refuses to start rather than
# start open. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
OUTREACH_API_KEY=generate-me-see-comment-above

# IANA time zone. Every date the service reports is in this zone, and so is
# "today" for the daily caps. Unset means UTC, which is
# deliberately wrong for a human so that forgetting is visible rather than
# quietly shifting a morning cron by several hours.
# OUTREACH_TZ=America/Chicago

# Rate limits are NOT set here. Messages and profile fetches per day are the
# UNIPILE_* variables under "Daily caps" below -- the service keeps no copy of
# them under a name of its own, because a second name would let it believe one
# ceiling while the client enforcing the call applied another.

# Every remaining OUTREACH_* variable below has the default shown beside it in
# `linkedinmcp/settings.py`; uncomment one only to override it. None of them
# has any effect on the notebooks.

# How many intro messages one daily planning run may queue.
# OUTREACH_INTRO_DAILY_CAP=10

# The random gap between one queued intro's due time and the next, in minutes.
# Both 0 makes every intro due at once; send_messages spaces the sends (one a
# minute by default). The maximum may not be below the minimum.
# OUTREACH_INTRO_GAP_MIN_MINUTES=0
# OUTREACH_INTRO_GAP_MAX_MINUTES=0

# Minimum days between messages to one contact before a follow-up is allowed.
# OUTREACH_MIN_DAYS_BETWEEN_TOUCHES=5

# Most outbound messages one contact may ever receive, the intro included.
# OUTREACH_MAX_TOUCHES=3

# Longest message body the service will send, in characters.
# OUTREACH_MESSAGE_MAX_CHARS=1200

# Comma-separated domains a queued message may link to. Unset, or set to an
# explicit empty value, both mean the same thing: no links allowed at all.
# OUTREACH_ALLOWED_LINK_DOMAINS=

# Industry labels (`analysis.industry`) eligible for an intro. Setting this to
# an explicit empty value makes NO contact eligible for an intro -- a
# deliberate kill switch, and not the same as leaving it unset, which gives
# the four industries shown here.
# OUTREACH_TARGET_INDUSTRIES=RCM,Pathology,Medical Lab,Physician Practice

# Where message templates (intro.md) are read from, relative to the working
# directory -- `Python/` locally, `/app` in the container.
# OUTREACH_TEMPLATES_DIR=templates

# Hold every newly queued message (follow-ups, drip steps, the daily job's
# intros) as pending for a human's approval before a tick may send it. A
# reply always waits regardless of this setting.
# OUTREACH_REQUIRE_APPROVAL=false

# How stale, in minutes, the cached account-wide send count may get before a
# tick recounts it from LinkedIn instead of trusting the cached figure.
# OUTREACH_BUDGET_SNAPSHOT_MAX_AGE_MINUTES=60

# Whether `POST /jobs/{tick,sync,daily}?dry_run=1` is honoured. Set to false
# to refuse dry runs on this service outright.
# OUTREACH_ALLOW_HTTP_DRY_RUN=true

# How many days back the daily job looks for new connections whose profile
# isn't stored yet. Older, unfetched connections are left for the notebooks'
# own backlog runs (new-contacts.ipynb).
# OUTREACH_NEW_CONNECTION_DAYS=14

# Signing key for an optional Claude platform webhook. Unset is the default
# and current state: no such route exists in the service yet, so this setting
# is reserved and has no effect either way.
# OUTREACH_ANTHROPIC_WEBHOOK_SIGNING_KEY=


# --- Unipile (LinkedIn contacts and messaging) --------------------------------
# Required. Copy the access token from the Unipile dashboard; UNIPILE_DNS is the
# tenant host shown alongside it. There is no usable default for either.
UNIPILE_API_KEY=your-unipile-access-token
UNIPILE_DNS=apiNN.unipile.com:NNNNN

# Optional. Resolved from GET /accounts on first use when unset. Set it for
# short-lived processes: every fresh one otherwise spends a GET /accounts on its
# first budget check, and the outreach service starts a new process per job.
# UNIPILE_ACCOUNT_ID=

# --- Daily caps ---------------------------------------------------------------
# LinkedIn restricts accounts that act too fast, so each action type has a cap
# over a rolling 24 hours. Nothing is counted locally between runs:
# new-contacts.ipynb counts the window at the start of every run from Firestore
# (contacts saved) and LinkedIn (invitations and messages sent), so a kernel
# restart cannot hand back a fresh allowance. Reaching a cap raises
# BudgetExhausted and stops the run.

# Connection invitations per day. LinkedIn's own weekly ceiling is around 100-200
# depending on account age and standing, so 25/day stays comfortably under it.
UNIPILE_MAX_INVITES_PER_DAY=25

# Direct messages per day, counted across new chats and replies alike.
UNIPILE_MAX_MESSAGES_PER_DAY=50

# Full profile reads per day. This is the tightest constraint in practice: it is
# the read LinkedIn throttles hardest, and every retry of a throttled fetch
# counts against it too. At 250/day, a 500-contact backlog takes about two days.
UNIPILE_MAX_PROFILE_FETCHES_PER_DAY=250

# Contacts lib.get_activity checks per rolling 24 h. A check is four reads (posts,
# comments, reactions, profile) plus one post read per distinct commented or reacted
# post. Unipile advises about 100 a day per route.
UNIPILE_MAX_ACTIVITY_CHECKS_PER_DAY=100

# Newest posts, comments and reactions lib.get_activity keeps per contact. Each kept
# comment and reaction costs one post read for its context (distinct posts only).
UNIPILE_ACTIVITY_ITEMS_PER_KIND=5

# Likes lib.get_activity sends per rolling 24 h: the newest own post of a contact it
# checks, at most one per contact per check. Unipile advises about 100 reactions a day.
UNIPILE_MAX_REACTIONS_PER_DAY=100

# Comments posted per rolling 24 h through the comment_on_post tool in live mode.
UNIPILE_MAX_COMMENTS_PER_DAY=10

# --- Pacing -------------------------------------------------------------------
# LinkedIn watches the rhythm of calls, not just their number. Every budgeted
# call waits first, for an interval drawn fresh each time: mostly short, with a
# reachable slow tail, interrupted by an occasional long break. All in seconds.

# Shortest possible gap between two calls. Raising this is the single most
# effective way to look less automated; it also lengthens the whole run.
UNIPILE_MIN_DELAY_SECONDS=20

# Longest possible ordinary gap. Gaps are skewed toward the low end, so the
# average lands nearer a third of the way up the range (~26s for 20-40) rather
# than at the midpoint.
UNIPILE_MAX_DELAY_SECONDS=40

# How often to take a long break, as an average number of calls between them.
# Each call rolls the dice independently, so breaks do not land on a predictable
# stride. Set to 0 to switch breaks off entirely.
UNIPILE_LONG_PAUSE_EVERY=10

# Shortest long break. Long enough to look like stepping away, not reloading.
UNIPILE_LONG_PAUSE_MIN_SECONDS=120

# Longest long break, drawn uniformly between the two bounds.
UNIPILE_LONG_PAUSE_MAX_SECONDS=300

# --- Crawler pacing -------------------------------------------------------------
# lib.get_activity paces itself with these instead of the UNIPILE_ delays and long
# breaks above, which keep pacing messages, invitations and every other call. The
# crawl is reads, four or more per contact, and takes its break between batches
# rather than mid-contact. Measured 2026-09-19 over 40 contacts: about 1.6 min a
# contact inside a batch, with no 429, no restriction and no withheld profile
# section. At the UNIPILE_ values the same contact took about 8 min.

# Contacts checked between batch pauses.
CRAWLER_BATCH_SIZE=10

# Shortest and longest pause between batches, drawn uniformly. This is the crawl's
# only long break: it never takes a UNIPILE_LONG_PAUSE.
CRAWLER_BATCH_PAUSE_MIN_SECONDS=240
CRAWLER_BATCH_PAUSE_MAX_SECONDS=480

# Gap before each call, skewed toward the shortest exactly as the UNIPILE_ gaps are.
CRAWLER_MIN_DELAY_SECONDS=8
CRAWLER_MAX_DELAY_SECONDS=20

# --- Throttle recovery ---------------------------------------------------------
# Throttling arrives as HTTP 200 with the requested sections empty, not as an
# error. Each withheld response doubles every subsequent gap (capped at 8x by
# HumanCadence.MAX_BACKOFF in lib/unipile/pacing.py) and retries the fetch.

# How many extra attempts a throttled profile fetch gets. 2 means up to three
# fetches, waiting roughly 2x then 4x the normal gap in between. Every attempt
# is charged to UNIPILE_MAX_PROFILE_FETCHES_PER_DAY, because LinkedIn counted
# it either way, so raising this trades daily reach for a better hit rate.
# Set to 0 to skip a throttled profile immediately and retry it on a later run.
UNIPILE_THROTTLE_RETRIES=2

# Give up on the whole run after this many profiles in a row exhaust their
# retries. At that point LinkedIn is throttling the account rather than a single
# profile, and every further fetch spends budget on data it will not return. One
# complete profile resets the count. Set to 0 to keep going regardless.
UNIPILE_MAX_CONSECUTIVE_THROTTLED=5

# --- Provider quota -------------------------------------------------------------
# LinkedIn reports its own invitation quota usage as a percentage. These act on
# that reading, independently of the local daily caps above.

# Log a warning once LinkedIn reports this much of the quota consumed.
UNIPILE_USAGE_WARN_PCT=75

# Stop sending invitations at this reading, before LinkedIn acts on its own.
UNIPILE_USAGE_HALT_PCT=90

# --- Everything else -------------------------------------------------------------
# Profile sections to request. Without these the API returns no experience,
# education, skills or About text at all -- the classifier would then be reading
# little more than a headline. A JSON list is accepted too.
#
# This is deliberately narrow. LinkedIn stalls when asked for more: on these two
# sections a 119-profile run completed ~99% of fetches. Adding education,skills,
# certifications gives the Gemini summary more to work with, but raises the
# chance LinkedIn withholds sections, and every retry spends daily budget.
UNIPILE_PROFILE_SECTIONS=about,experience

# HTTP timeout per request. Reads retry 4 times over 2/10/30s on 5xx and network
# errors; writes are never retried, since a retried invitation is a second real
# invitation to a real person.
UNIPILE_TIMEOUT_SECONDS=30
