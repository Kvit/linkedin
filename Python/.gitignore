# Environment variables
.env

# Every .json is ignored -- service-account keys, the budget state file and
# captured profiles all land here. Anything the repo genuinely needs is
# re-added by name below.
*.json
!.devcontainer/devcontainer.json
# Test fixtures are sanitized API captures and must be committed, or the suite
# cannot run from a fresh clone.
!tests/**/fixtures/*.json

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# uv
.uv/

# Jupyter
.ipynb_checkpoints/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
