FROM mcr.microsoft.com/devcontainers/python:2-3.13-bookworm

# Set the working directory in the container
WORKDIR /app

# Install uv
RUN pip install uv

# Copy dependency files first (for better caching)
COPY pyproject.toml /app/
COPY uv.lock* /app/

# Install dependencies. --no-install-project because this image carries only
# main.py and functions.py, not the package `pyproject.toml` now declares; the
# CMD passes --no-sync for the same reason -- an unguarded `uv run` re-syncs,
# tries to build the project, and fails on the README this image never copies.
RUN uv sync --no-dev --no-install-project

# Copy application code
COPY main.py /app
COPY functions.py /app

# Make port 8080 available to the world outside this container
EXPOSE 8080

# copy .env file to etc/environment
COPY .env /etc/environment

# Run app.py when the container launches
CMD ["uv", "run", "--no-sync", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080"]
